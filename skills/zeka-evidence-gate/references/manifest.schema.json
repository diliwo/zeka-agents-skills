                  "minLength": 1
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "finished_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "start_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "end_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "worktree_clean": {
