      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "document",
            "issue",
            "decision",
            "repository_contract"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "fragment": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "locator"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "tool",
              "runtime",
              "service",
              "image"
            ]
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "version",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
