{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zeka evidence manifest version 1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "branch": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "contract_ref": {
      "$ref": "#/$defs/reference"
    },
    "required_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 0
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      },
      "minItems": 0
    },
    "caveats": {
      "$ref": "#/$defs/caveats"
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "created_at",
    "synthetic",
    "repository",
    "branch",
    "head_sha",
    "scope",
    "required_targets",
    "records",
    "artifacts",
    "comparisons",
    "caveats"
  ],
  "additionalProperties": false,
  "$defs": {
