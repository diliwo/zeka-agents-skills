          "required": [
            "kind",
            "metadata"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "github_api"
            },
            "metadata": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "endpoint": {
                  "type": "string",
